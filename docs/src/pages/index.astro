---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trade Trace</title>
    <style>
      :root,
      [data-theme="dark"] {
        --gray-50: 255 255 255;
        --gray-100: 241 245 249;
        --gray-200: 214 224 236;
        --gray-300: 182 196 212;
        --gray-400: 152 165 182;
        --gray-500: 142 156 175;
        --gray-600: 78 90 106;
        --gray-700: 52 64 80;
        --gray-800: 30 41 55;
        --gray-900: 15 23 38;
        --gray-950: 3 7 18;

        --semantic-up: 52 211 153;
        --semantic-down: 248 113 113;
        --semantic-neutral: 156 163 175;
        --semantic-maker: 16 185 129;
        --semantic-taker: 245 158 11;

        --color-primary: rgb(var(--semantic-up));
        --color-primary-dark: rgb(5 150 105);
        --color-success: rgb(var(--semantic-up));
        --color-warning: rgb(var(--semantic-taker));
      }

      [data-theme="light"] {
        --gray-950: 248 250 252;
        --gray-900: 241 245 249;
        --gray-800: 226 232 240;
        --gray-700: 203 213 225;
        --gray-600: 148 163 184;
        --gray-500: 94 109 128;
        --gray-400: 71 85 105;
        --gray-300: 51 65 85;
        --gray-200: 30 41 59;
        --gray-100: 15 23 42;
        --gray-50: 2 6 23;

        --semantic-up: 4 120 87;
        --semantic-down: 185 28 28;
        --semantic-neutral: 75 85 99;
        --semantic-maker: 4 120 87;
        --semantic-taker: 180 83 9;

        --color-primary: rgb(var(--semantic-up));
        --color-primary-dark: rgb(4 120 87);
        --color-success: rgb(var(--semantic-up));
        --color-warning: rgb(var(--semantic-taker));
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-primary: var(--color-slate-900);
          --bg-secondary: var(--color-slate-800);
          --text-primary: var(--color-slate-50);
          --text-secondary: var(--color-slate-300);
          --text-tertiary: var(--color-slate-400);
          --border-color: var(--color-slate-700);
          --code-bg: var(--color-slate-800);
        }
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg-primary: white;
          --bg-secondary: var(--color-slate-50);
          --text-primary: var(--color-slate-900);
          --text-secondary: var(--color-slate-600);
          --text-tertiary: var(--color-slate-500);
          --border-color: var(--color-slate-200);
          --code-bg: var(--color-slate-100);
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: var(--text-primary);
        background-color: var(--bg-primary);
        color-scheme: light dark;
      }

      /* Header / Hero */
      header {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
        color: white;
        padding: 4rem 2rem 5rem;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .header-content {
        max-width: 1200px;
        margin: 0 auto;
      }

      .logo-badge {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
      }

      .tagline {
        font-size: 1.25rem;
        opacity: 0.95;
        margin-bottom: 2rem;
        font-weight: 500;
      }

      .header-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: white;
        color: var(--color-primary);
        text-decoration: none;
        border-radius: 0.375rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        border: 2px solid white;
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      }

      .btn-secondary {
        background: transparent;
        color: white;
        border-color: white;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      /* Main Container */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      section {
        padding: 4rem 2rem;
      }

      .section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }

      .section-subtitle {
        font-size: 1.125rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      /* Status Bar */
      .status-bar {
        background-color: var(--color-success);
        color: white;
        padding: 1.25rem 2rem;
        margin: 3rem 2rem 0;
        border-radius: 0.375rem;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
      }

      .status-bar strong {
        font-weight: 600;
      }

      /* Card Grid */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        padding: 2rem;
        transition: all 0.3s ease;
      }

      .card:hover {
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
      }

      .card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--color-primary);
      }

      .card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      /* Feature Grid */
      .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .feature {
        padding: 1.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        transition: all 0.3s ease;
      }

      .feature:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
      }

      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
      }

      .feature h4 {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }

      .feature p {
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      /* Tech Stack */
      .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .tech-item {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        border-radius: 0.375rem;
      }

      .tech-item h4 {
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--color-primary);
      }

      .tech-item ul {
        list-style: none;
        font-size: 0.9rem;
      }

      .tech-item li {
        padding: 0.25rem 0;
        color: var(--text-secondary);
      }

      /* Footer */
      footer {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        padding: 3rem 2rem;
        margin-top: 3rem;
        text-align: center;
        color: var(--text-secondary);
      }

      footer p {
        margin-bottom: 0.5rem;
      }

      footer a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      footer a:hover {
        color: var(--color-primary-dark);
        text-decoration: underline;
      }

      /* Responsive */
      @media (max-width: 768px) {
        h1 {
          font-size: 2rem;
        }

        section {
          padding: 2rem 1rem;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .header-links {
          flex-direction: column;
        }

        .btn {
          width: 100%;
          text-align: center;
        }
      }

      /* Links */
      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      a:hover {
        color: var(--color-primary-dark);
      }

      /* Code blocks */
      code {
        background: var(--code-bg);
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: 0.9em;
      }

      pre {
        background: var(--code-bg);
        border: 1px solid var(--border-color);
        padding: 1rem;
        border-radius: 0.375rem;
        overflow-x: auto;
        margin: 1rem 0;
      }

      pre code {
        background: none;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-content">
        <svg class="logo-badge" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <circle cx="100" cy="100" r="95" fill="none" stroke="white" stroke-width="2" opacity="0.2"/>
          <rect x="35" y="70" width="40" height="40" rx="4" fill="white" opacity="0.95"/>
          <circle cx="55" cy="90" r="8" fill="#2563eb"/>
          <rect x="125" y="70" width="40" height="40" rx="4" fill="white" opacity="0.95"/>
          <path d="M 140 85 L 145 95 L 155 85" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="75" y1="90" x2="125" y2="90" stroke="white" stroke-width="2"/>
          <circle cx="100" cy="90" r="3" fill="white"/>
          <circle cx="85" cy="90" r="2" fill="white"/>
          <circle cx="115" cy="90" r="2" fill="white"/>
          <path d="M 75 130 L 78 138 L 86 138 L 79 143 L 82 151 L 75 146 L 68 151 L 71 143 L 64 138 L 72 138 Z" fill="white"/>
          <path d="M 100 130 L 103 138 L 111 138 L 104 143 L 107 151 L 100 146 L 93 151 L 96 143 L 89 138 L 97 138 Z" fill="white"/>
          <path d="M 125 130 L 128 138 L 136 138 L 129 143 L 132 151 L 125 146 L 118 151 L 121 143 L 114 138 L 122 138 Z" fill="white"/>
        </svg>
        <h1>Trade Trace</h1>
        <p class="tagline">Transparent tradesman reviews with blockchain immutability</p>
        <div class="header-links">
          <a href="https://github.com/milesburton/trade-trace" class="btn">View on GitHub</a>
          <a href="https://discord.gg/tSGgsKnz" class="btn btn-secondary">Join Discord</a>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="status-bar">
        <strong>✅ Status:</strong> Full-Stack Prototype · Frontend Deployed · Docs Live · Last Updated: 2026-09-19
      </div>
    </div>

    <section>
      <div class="container">
        <h2 class="section-title">Overview</h2>
        <p class="section-subtitle">Transparent tradesman reviews with blockchain immutability</p>
        <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; max-width: 800px;">
          Trade Trace is a full-stack prototype for a transparent review platform. Submit reviews, build trust networks, and verify tradesman credentials with cryptographic proof. Built with a modern, type-safe React frontend and Deno backend, styled with the veta-trading-platform design system.
        </p>
      </div>
    </section>

    <section style="background: var(--bg-secondary);">
      <div class="container">
        <h2 class="section-title">Key Features</h2>
        <p class="section-subtitle">Production-ready capabilities</p>
        <div class="features">
          <div class="feature">
            <div class="feature-icon">🎨</div>
            <h4>Veta Design System</h4>
            <p>Professional styling with semantic colors and theme support (dark/light/high-contrast)</p>
          </div>
          <div class="feature">
            <div class="feature-icon">⛓️</div>
            <h4>Blockchain Ready</h4>
            <p>Architecture supports immutable review records with cryptographic proof</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🚀</div>
            <h4>Full-Stack Prototype</h4>
            <p>Deno backend, React frontend, PostgreSQL database, media storage included</p>
          </div>
          <div class="feature">
            <div class="feature-icon">✅</div>
            <h4>Well Tested</h4>
            <p>Vitest for unit tests and Playwright for E2E testing</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🌓</div>
            <h4>Multi-Theme Support</h4>
            <p>Dark, light, and high-contrast themes with system preference detection</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🔄</div>
            <h4>Auto-Deploy</h4>
            <p>CI/CD ready: Vercel, Railway, GitHub Pages with auto-deployment on push</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title">Technology Stack</h2>
        <p class="section-subtitle">Built with modern, battle-tested technologies</p>
        <div class="tech-grid">
          <div class="tech-item">
            <h4>Frontend</h4>
            <ul>
              <li>React 18.3.1</li>
              <li>TypeScript 5.5.3</li>
              <li>Tailwind CSS 3.4.6</li>
              <li>Vite 7.3.2</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>Backend</h4>
            <ul>
              <li>Deno runtime</li>
              <li>Oak framework</li>
              <li>PostgreSQL driver</li>
              <li>JWT authentication</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>Database & Storage</h4>
            <ul>
              <li>PostgreSQL</li>
              <li>Neon (serverless)</li>
              <li>Supabase Storage</li>
              <li>Media support</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>DevOps & Deploy</h4>
            <ul>
              <li>Vercel (frontend/backend)</li>
              <li>GitHub Pages (docs)</li>
              <li>GitHub Actions</li>
              <li>Auto-deploy on push</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--bg-secondary);">
      <div class="container">
        <h2 class="section-title">Get Started</h2>
        <p class="section-subtitle">Three ways to explore Trade Trace</p>
        <div class="grid">
          <div class="card">
            <h3>📖 Documentation</h3>
            <p>Complete documentation including architecture, setup, and development guides at <a href="https://github.com/milesburton/trade-trace/blob/main/README.md">GitHub</a></p>
          </div>
          <div class="card">
            <h3>🚀 Quick Start</h3>
            <p>Get up and running in minutes. See <a href="https://github.com/milesburton/trade-trace/blob/main/QUICK_START.md">QUICK_START.md</a> for fast setup instructions</p>
          </div>
          <div class="card">
            <h3>💬 Community</h3>
            <p>Join our <a href="https://discord.gg/tSGgsKnz">Discord community</a> for support, updates, and discussions</p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <p><strong>Trade Trace</strong> · Transparent tradesman reviews with blockchain immutability</p>
      <p>Version 0.1.0 · Licensed under MIT · Full-Stack Prototype</p>
      <p><a href="https://github.com/milesburton/trade-trace">GitHub Repository</a> · <a href="https://milesburton.github.io/trade-trace/">Documentation</a></p>
    </footer>
  </body>
</html>
