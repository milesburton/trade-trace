---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trade Trace</title>
    <style>
      :root {
        --color-primary: #2563eb;
        --color-primary-dark: #1e40af;
        --color-success: #10b981;
        --color-warning: #f59e0b;
        --color-slate-50: #f8fafc;
        --color-slate-100: #f1f5f9;
        --color-slate-200: #e2e8f0;
        --color-slate-300: #cbd5e1;
        --color-slate-400: #94a3b8;
        --color-slate-500: #64748b;
        --color-slate-600: #475569;
        --color-slate-700: #334155;
        --color-slate-800: #1e293b;
        --color-slate-900: #0f172a;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-primary: var(--color-slate-900);
          --bg-secondary: var(--color-slate-800);
          --text-primary: var(--color-slate-50);
          --text-secondary: var(--color-slate-300);
          --text-tertiary: var(--color-slate-400);
          --border-color: var(--color-slate-700);
          --code-bg: var(--color-slate-800);
        }
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg-primary: white;
          --bg-secondary: var(--color-slate-50);
          --text-primary: var(--color-slate-900);
          --text-secondary: var(--color-slate-600);
          --text-tertiary: var(--color-slate-500);
          --border-color: var(--color-slate-200);
          --code-bg: var(--color-slate-100);
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: var(--text-primary);
        background-color: var(--bg-primary);
        color-scheme: light dark;
      }

      /* Header / Hero */
      header {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
        color: white;
        padding: 4rem 2rem 5rem;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .header-content {
        max-width: 1200px;
        margin: 0 auto;
      }

      .logo-badge {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
      }

      .tagline {
        font-size: 1.25rem;
        opacity: 0.95;
        margin-bottom: 2rem;
        font-weight: 500;
      }

      .header-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: white;
        color: var(--color-primary);
        text-decoration: none;
        border-radius: 0.375rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        border: 2px solid white;
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      }

      .btn-secondary {
        background: transparent;
        color: white;
        border-color: white;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      /* Main Container */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      section {
        padding: 4rem 2rem;
      }

      .section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }

      .section-subtitle {
        font-size: 1.125rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      /* Status Bar */
      .status-bar {
        background-color: var(--color-success);
        color: white;
        padding: 1.25rem 2rem;
        margin: 3rem 2rem 0;
        border-radius: 0.375rem;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
      }

      .status-bar strong {
        font-weight: 600;
      }

      /* Card Grid */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        padding: 2rem;
        transition: all 0.3s ease;
      }

      .card:hover {
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
      }

      .card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--color-primary);
      }

      .card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      /* Feature Grid */
      .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .feature {
        padding: 1.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        transition: all 0.3s ease;
      }

      .feature:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
      }

      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
      }

      .feature h4 {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }

      .feature p {
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      /* Tech Stack */
      .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .tech-item {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        border-radius: 0.375rem;
      }

      .tech-item h4 {
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--color-primary);
      }

      .tech-item ul {
        list-style: none;
        font-size: 0.9rem;
      }

      .tech-item li {
        padding: 0.25rem 0;
        color: var(--text-secondary);
      }

      /* Footer */
      footer {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        padding: 3rem 2rem;
        margin-top: 3rem;
        text-align: center;
        color: var(--text-secondary);
      }

      footer p {
        margin-bottom: 0.5rem;
      }

      footer a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      footer a:hover {
        color: var(--color-primary-dark);
        text-decoration: underline;
      }

      /* Responsive */
      @media (max-width: 768px) {
        h1 {
          font-size: 2rem;
        }

        section {
          padding: 2rem 1rem;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .header-links {
          flex-direction: column;
        }

        .btn {
          width: 100%;
          text-align: center;
        }
      }

      /* Links */
      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      a:hover {
        color: var(--color-primary-dark);
      }

      /* Code blocks */
      code {
        background: var(--code-bg);
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: 0.9em;
      }

      pre {
        background: var(--code-bg);
        border: 1px solid var(--border-color);
        padding: 1rem;
        border-radius: 0.375rem;
        overflow-x: auto;
        margin: 1rem 0;
      }

      pre code {
        background: none;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-content">
        <svg class="logo-badge" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <circle cx="100" cy="100" r="95" fill="none" stroke="white" stroke-width="2" opacity="0.2"/>
          <rect x="35" y="70" width="40" height="40" rx="4" fill="white" opacity="0.95"/>
          <circle cx="55" cy="90" r="8" fill="#2563eb"/>
          <rect x="125" y="70" width="40" height="40" rx="4" fill="white" opacity="0.95"/>
          <path d="M 140 85 L 145 95 L 155 85" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="75" y1="90" x2="125" y2="90" stroke="white" stroke-width="2"/>
          <circle cx="100" cy="90" r="3" fill="white"/>
          <circle cx="85" cy="90" r="2" fill="white"/>
          <circle cx="115" cy="90" r="2" fill="white"/>
          <path d="M 75 130 L 78 138 L 86 138 L 79 143 L 82 151 L 75 146 L 68 151 L 71 143 L 64 138 L 72 138 Z" fill="white"/>
          <path d="M 100 130 L 103 138 L 111 138 L 104 143 L 107 151 L 100 146 L 93 151 L 96 143 L 89 138 L 97 138 Z" fill="white"/>
          <path d="M 125 130 L 128 138 L 136 138 L 129 143 L 132 151 L 125 146 L 118 151 L 121 143 L 114 138 L 122 138 Z" fill="white"/>
        </svg>
        <h1>Trade Trace</h1>
        <p class="tagline">Transparent tradesman reviews with blockchain immutability</p>
        <div class="header-links">
          <a href="https://github.com/milesburton/trade-trace" class="btn">View on GitHub</a>
          <a href="https://discord.gg/tSGgsKnz" class="btn btn-secondary">Join Discord</a>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="status-bar">
        <strong>✅ Status:</strong> Production Ready · Version 0.1.0 · Last Updated: 2026-09-19
      </div>
    </div>

    <section>
      <div class="container">
        <h2 class="section-title">Overview</h2>
        <p class="section-subtitle">A comprehensive trade execution and compliance monitoring platform</p>
        <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; max-width: 800px;">
          Trade Trace is built on the same professional standards as VETA Trading Platform. Track trades, verify compliance rules, and analyze execution patterns across multiple asset classes with a modern, type-safe React application.
        </p>
      </div>
    </section>

    <section style="background: var(--bg-secondary);">
      <div class="container">
        <h2 class="section-title">Key Features</h2>
        <p class="section-subtitle">Production-ready capabilities</p>
        <div class="features">
          <div class="feature">
            <div class="feature-icon">🎨</div>
            <h4>Professional Design</h4>
            <p>React 18, TypeScript, and Tailwind CSS following VETA standards</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🔒</div>
            <h4>Type Safe</h4>
            <p>Full TypeScript strict mode with zero implicit any</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🚀</div>
            <h4>Performance</h4>
            <p>Vite for blazing fast development and production builds</p>
          </div>
          <div class="feature">
            <div class="feature-icon">✅</div>
            <h4>Well Tested</h4>
            <p>Vitest for unit tests and Playwright for E2E testing</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🌓</div>
            <h4>Dark Mode</h4>
            <p>Full dark/light theme support with system preference detection</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🔄</div>
            <h4>CI/CD Ready</h4>
            <p>5 GitHub Actions workflows for automated testing and deployment</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title">Technology Stack</h2>
        <p class="section-subtitle">Built with modern, battle-tested technologies</p>
        <div class="tech-grid">
          <div class="tech-item">
            <h4>Frontend</h4>
            <ul>
              <li>React 18.3.1</li>
              <li>TypeScript 5.5.3</li>
              <li>Tailwind CSS 3.4.6</li>
              <li>Vite 7.3.2</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>Testing</h4>
            <ul>
              <li>Vitest 4.0.18</li>
              <li>Playwright 1.58.2</li>
              <li>Testing Library</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>Code Quality</h4>
            <ul>
              <li>Biome 2.4.4</li>
              <li>TypeScript strict</li>
              <li>Husky pre-commit</li>
            </ul>
          </div>
          <div class="tech-item">
            <h4>DevOps</h4>
            <ul>
              <li>GitHub Actions</li>
              <li>GitHub Pages</li>
              <li>npm 10+</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--bg-secondary);">
      <div class="container">
        <h2 class="section-title">Get Started</h2>
        <p class="section-subtitle">Three ways to explore Trade Trace</p>
        <div class="grid">
          <div class="card">
            <h3>📖 Documentation</h3>
            <p>Complete documentation including architecture, setup, and development guides at <a href="https://github.com/milesburton/trade-trace/blob/main/README.md">GitHub</a></p>
          </div>
          <div class="card">
            <h3>🚀 Quick Start</h3>
            <p>Get up and running in minutes. See <a href="https://github.com/milesburton/trade-trace/blob/main/QUICK_START.md">QUICK_START.md</a> for fast setup instructions</p>
          </div>
          <div class="card">
            <h3>💬 Community</h3>
            <p>Join our <a href="https://discord.gg/tSGgsKnz">Discord community</a> for support, updates, and discussions</p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <p><strong>Trade Trace</strong> · Comprehensive trade execution and compliance monitoring</p>
      <p>Version 0.1.0 · Licensed under MIT</p>
      <p><a href="https://github.com/milesburton/trade-trace">GitHub Repository</a> · <a href="https://discord.gg/tSGgsKnz">Discord Community</a></p>
    </footer>
  </body>
</html>
